    "dataViewMappings": [
        {
            "conditions": [
                {
                    "source": {
                        "max": 1
                    },
                    "direction": {
                        "max": 1
                    },
                    "amount": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "source"
                            }
                        },
                        {
                            "for": {
                                "in": "direction"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 100
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "amount"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "source",
            "direction",
            "amount"
        ],
        "supportEnhancedTooltips": true
    },
    "supportsKeyboardFocus": true,
    "supportsHighlight": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsMultiVisualSelection": true,
    "sorting": {
        "default": {}
    },
    "privileges": []
